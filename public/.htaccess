# ============================================================
# Anixsoft — Apache rules for the static export
# Copy this to your web root alongside the exported files.
# ============================================================

RewriteEngine On

# --- Force HTTPS (fixes the mixed-content issue on the old site) ---
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# --- 301 redirects from the old WordPress URLs ---
Redirect 301 /about-us/                    /about/
Redirect 301 /website/                     /work/
Redirect 301 /mobile-apps/                 /work/
Redirect 301 /review/                      /about/
Redirect 301 /technical-accomplishments/   /services/
Redirect 301 /technologies/                /services/
Redirect 301 /who-are-we-what-do-we-do/    /about/
Redirect 301 /contact-us/                  /contact/
Redirect 301 /project-execution-structure/ /services/
Redirect 301 /training/                    /services/

# --- Dead WooCommerce pages: tell Google they are gone for good ---
RedirectMatch 410 ^/cart/?$
RedirectMatch 410 ^/my-account/?$
RedirectMatch 410 ^/checkout/?$

# --- Serve pretty URLs from the static export ---
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /$1/index.html [L]

ErrorDocument 404 /404.html

# --- Caching ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# --- Security headers ---
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
